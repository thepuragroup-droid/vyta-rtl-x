# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# HD Wallet (PUBLIC xpubs only — cannot spend)
BTC_XPUB=your_btc_xpub_here
ETH_XPUB=your_eth_xpub_here
# SOL addresses are pre-generated and stored in sol_addresses table

# Blockchain APIs
ALCHEMY_ETH_API_KEY=your_alchemy_eth_key_here
ALCHEMY_SOL_API_KEY=your_alchemy_sol_key_here

# Cron security
CRON_SECRET=your_random_64_char_hex_here

# Base URL
# NOT AN ENV VAR ANYMORE. The public origin used to build links that leave the
# app (emails, magic-link redirects) is hard-coded as `SITE_URL` in lib/config.ts.
# It used to be NEXT_PUBLIC_BASE_URL, but a localhost value set in the deployed
# environment shipped dead http://localhost:3000/... buttons in admin email.
# Nothing reads NEXT_PUBLIC_BASE_URL now; setting it has no effect.

# Email — ALL outbound mail (storefront order/affiliate emails, admin
# notifications, invoices) is sent through the custom SMTP server below via
# nodemailer. Configure the SMTP_* vars at the bottom of this file.
# (RESEND_API_KEY / EMAIL_FROM are no longer used to send mail and can be omitted.)

# Shipping (Easyship) — normally configured in Admin → Settings → Shipping,
# which stores the token + origin in the site_settings table. These env vars
# are optional fallbacks used when the DB values are empty.
# EASYSHIP_API_KEY=your_easyship_api_token_here
# Override the API base/version only if Easyship changes it (default below).
# EASYSHIP_API_URL=https://public-api.easyship.com/2024-09
# REQUIRED for the Easyship webhook (/api/webhooks/easyship). Without it the
# webhook fails closed (503) so it can't be used to forge order/tracking state.
# Set this to the signing secret configured in your Easyship webhook settings.
EASYSHIP_WEBHOOK_SECRET=your_easyship_webhook_signing_secret

# PuraMass (Stealth Health) hosted checkout — SERVER-ONLY. Opt-in alternative
# checkout toggled in Admin → Settings → PuraMass Checkout. The API key is a
# live payment secret: never expose it to the browser (no NEXT_PUBLIC_ prefix).
# PURAMASS_API_KEY=sk_live_your_partner_api_key_here
# Partner id (default ptr_puramass) and API base URL (default below) rarely change.
# PURAMASS_PARTNER_ID=ptr_puramass
# PURAMASS_API_URL is NOT used — override the base with PURAMASS_API_BASE_URL.
# PURAMASS_API_BASE_URL=https://api.stealth.health
# Signing secret for the store_order.payment_complete webhook
# (/api/webhooks/stealth-health). Without it the webhook fails closed (500).
# PURAMASS_WEBHOOK_SECRET=your_puramass_webhook_signing_secret
# Dedicated secret for the payment poller cron (/api/cron/puramass-poll), so it
# can be rotated independently of the shared CRON_SECRET. If unset, the poller
# falls back to CRON_SECRET. The scheduled job must send this exact value as
# `Authorization: Bearer <value>`. Generate with: openssl rand -hex 32
# PURAMASS_CRON_SECRET=your_random_64_char_hex_here
#
# Partner settlement ledger (GET /partner/settlement) — the per-appointment
# financials we reconcile against, surfaced at Admin → Stealth Health →
# Reconcile. It needs NO extra credentials: it reuses PURAMASS_API_KEY and
# PURAMASS_PARTNER_ID above. Two things to know before it will answer:
#   * It is off by default and Stealth Health enable it per account, and it
#     requires clinical tier. Until they switch it on the endpoint 403s/404s
#     and the Reconcile tab says so rather than showing an empty window.
#   * Unlike the catalog endpoints it is NOT open in sandbox, because it
#     returns real financial data — so it can only be exercised against a
#     live key.

# SMTP (nodemailer) — powers ALL outbound email (order acks, admin
# notifications, BCC, invoices). Example below is Proton; any SMTP host works.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=noreply@aminocan.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=Aminocan <noreply@aminocan.com>

# Analytics (Google Tag Manager + GA4) — normally configured in Admin →
# Branding & Tracking, which stores the ids in the site_settings table. These
# env vars are optional fallbacks used when the DB values are empty (the app
# then falls back once more to the ids shipped in lib/site-config.ts). Both are
# public client-side identifiers, hence the NEXT_PUBLIC_ prefix.
# When a container id is set, the GA4 tag is configured INSIDE GTM and gtag.js
# is not loaded separately — set only the GA4 id to load gtag.js directly.
# NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Klaviyo — normally configured in Admin → Settings → Klaviyo, which stores the
# keys in site_settings. This env var is an optional SERVER-ONLY fallback for the
# private key, used when the DB value is empty. Never prefix it NEXT_PUBLIC_.
# KLAVIYO_PRIVATE_API_KEY=pk_your_private_klaviyo_key
